// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  manager
  employee
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
  forwarded
}

enum ResourceStatus {
  available
  inUse
  underMaintenance
}

enum CompanyIndustry {
  technology
  finance
  healthcare
  education
  retail
  manufacturing
  construction
  hospitality
  legal
  other
}

model User {
  username         String         @unique
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  description      String?
  companyId        String?
  role             Role?
  departmentId     String?
  resourceItems    ResourceItem[]
  department       Department?    @relation(fields: [departmentId], references: [id])
  company          Company?       @relation(fields: [companyId], references: [id])
  createdRequests  request[]      @relation("requestedByUser")
  reviewedRequests request[]      @relation("reviewedByUser")
  addedResources   Resource[]     @relation("addedByUser")
  joinedAt         DateTime?
  leftAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Company {
  id          String           @id @default(cuid())
  companyName String
  email       String           @unique
  address     String
  size        Int
  website     String?
  phoneNumber String?
  industry    CompanyIndustry?
  users       User[]
  resources   Resource[]
  requests    request[]
  departments Department[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  joinTokens  joinToken[]
  joinCodes   joinCode[]
}

model Department {
  id         String      @id @default(cuid())
  name       String
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  resources  Resource[]
  joinTokens joinToken[]
  joinCodes  joinCode[]

  @@unique([companyId, name])
}

model Resource {
  id            String         @id @default(cuid())
  name          String
  type          String
  companyId     String
  resourceItems ResourceItem[]
company        Company       @relation(fields: [companyId], references: [id])
  requests       request[]
  departmentId   String
  department     Department    @relation(fields: [departmentId], references: [id])
  description    String?
  createdById    String?
  createdBy      User?         @relation("addedByUser", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ResourceItem {
  id           String         @id @default(cuid())
  status       ResourceStatus
  location     String
  resourceId   String
  acquiredById String?
  acquiredBy   User?          @relation(fields: [acquiredById], references: [id])
  resource     Resource       @relation(fields: [resourceId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model request {
  id                String        @id @default(cuid())
  requestedById     String
  reviewedById      String?
  requestedQuantity Int
  status            RequestStatus
  companyId         String
  resourceId        String
  resource          Resource      @relation(fields: [resourceId], references: [id])
  company           Company       @relation(fields: [companyId], references: [id])
  requestedBy       User          @relation("requestedByUser", fields: [requestedById], references: [id])
  reviewedBy        User?         @relation("reviewedByUser", fields: [reviewedById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model joinToken {
  id           String     @id @default(cuid())
  email        String
  token        String     @unique
  companyId    String
  departmentId String
  company      Company    @relation(fields: [companyId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  role         Role
  expiresAt    DateTime
  used         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model joinCode {
  id           String     @id @default(cuid())
  code         String     @unique
  companyId    String
  departmentId String
  company      Company    @relation(fields: [companyId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  role         Role
  expiresAt    DateTime
  used         Boolean    @default(false)
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  manager
  employee
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum ResourceStatus {
  available
  inUse
  underMaintainence
}

model user {
  username         String    @unique
  id               String    @id @default(cuid())
  email            String    @unique
  role             Role?
  password         String
  description      String?
  enrolled         Boolean   @default(false)
  companyId        String?
  company          company?  @relation(fields: [companyId], references: [id])
  createdRequests  request[] @relation("requestedByUser")
  reviewedRequests request[] @relation("reviewedByUser")
}

model company {
  id          String     @unique @default(cuid())
  companyName String
  email       String     @unique
  address     String
  size        Int
  users       user[]
  resources   resource[]
  requests    request[]
}

model resource {
  id                       String         @unique @default(cuid())
  name                     String
  location                 String
  department               String
  type                     String
  availability             Boolean
  status                   ResourceStatus
  totalQuantity            Int
  inUseQuantity            Int            @default(0)
  underMaintenanceQuantity Int            @default(0)
  availableQuantity        Int
  createdAt                DateTime
  updatedAt                DateTime
  companyId                String
  company                  company        @relation(fields: [companyId], references: [id])
  requests                 request[]
}

model request {
  id                String        @unique @default(cuid())
  requestedById     String
  reviewedById      String?
  requestedQuantity Int
  status            RequestStatus
  companyId         String
  resourceId        String
  resource          resource      @relation(fields: [resourceId], references: [id])
  company           company       @relation(fields: [companyId], references: [id])
  requestedBy       user          @relation("requestedByUser", fields: [requestedById], references: [id])
  reviewedBy        user?         @relation("reviewedByUser", fields: [reviewedById], references: [id])
}

model joinToken {
  email     String
  token     String   @unique
  companyId String
  role      Role
  expiresAt DateTime
  used      Boolean  @default(false)
}

model joinCode {
  code      String   @unique
  companyId String
  role      Role
  expiresAt DateTime
  used      Boolean  @default(false)
}
